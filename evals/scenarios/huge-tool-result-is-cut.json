{
  "name": "huge-tool-result-is-cut",
  "description": "A tool returning far more than the context budget is cut for the model while the stored event keeps it.",
  "messages": ["Read it."],
  "tools": [
    {
      "name": "dump",
      "effect": "read",
      "result": "line of text\n",
      "repeat": 20000
    }
  ],
  "script": {
    "turns": [
      {
        "toolCalls": [
          {
            "id": "c1",
            "name": "dump",
            "arguments": {}
          }
        ]
      },
      {
        "text": ["Read."]
      }
    ]
  },
  "expect": [
    {
      "status": "done",
      "toolResultTruncated": true,
      "replyIncludes": ["Read."]
    }
  ]
}
