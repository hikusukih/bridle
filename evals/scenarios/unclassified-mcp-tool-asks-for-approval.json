{
  "name": "unclassified-mcp-tool-asks-for-approval",
  "description": "A plug-in tool the user never classified is treated as external: it waits for a card, does not run when declined, and runs only when approved.",
  "messages": ["Clear my scratch notes.", "Clear them, I do mean it."],
  "mcpServers": [
    {
      "name": "scratch",
      "tools": [
        {
          "name": "wipe",
          "description": "Delete all scratch notes.",
          "result": "wiped"
        }
      ]
    }
  ],
  "script": {
    "turns": [
      {
        "toolCalls": [
          {
            "id": "c1",
            "name": "scratch__wipe",
            "arguments": {}
          }
        ]
      },
      {
        "text": ["Not done."]
      },
      {
        "toolCalls": [
          {
            "id": "c2",
            "name": "scratch__wipe",
            "arguments": {}
          }
        ]
      },
      {
        "text": ["Done."]
      }
    ]
  },
  "expect": [
    {
      "status": "done",
      "approvals": ["decline"],
      "executed": [],
      "eventTypes": ["message", "tool_call", "approval_request", "approval_decision", "tool_result", "text"]
    },
    {
      "status": "done",
      "approvals": ["approve"],
      "executed": ["scratch__wipe"],
      "eventTypes": ["message", "tool_call", "approval_request", "approval_decision", "tool_result", "text"]
    }
  ]
}
